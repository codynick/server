[Unit]
Description=CodyNick classroom web application
After=network.target codynick-server-runner.service
Requires=codynick-server-runner.service
[Service]
User=codynick-web
Group=codynick-web
EnvironmentFile=/etc/codynick-server.env
WorkingDirectory=/opt/codynick-server/current/server
ExecStart=/opt/codynick-server/current/venv/bin/gunicorn --bind 127.0.0.1:8100 --workers 1 --threads 8 --timeout 60 app:app
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codynick-server
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
