[Unit]
Description=CodyNick restricted classroom execution broker
After=docker.service
Requires=docker.service
[Service]
EnvironmentFile=/etc/codynick-server.env
Environment=CN_IMAGE=codynick-classroom:0.1.0
ExecStart=/usr/bin/python3 /opt/codynick-server/current/server/broker.py
RuntimeDirectory=codynick-server
RuntimeDirectoryMode=0755
Restart=on-failure
KillMode=control-group
UMask=0077
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/codynick-server
PrivateTmp=true
[Install]
WantedBy=multi-user.target
